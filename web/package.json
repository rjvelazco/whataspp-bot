{
  "name": "store-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" --max-warnings 0 && npm run lint:spacing && npm run test:spacing && npm run test:unit && prettier --check \"src/**/*.{ts,html,css}\" \"scripts/*.mjs\" \"*.mjs\" \"spacing-baseline.json\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/*.mjs\" \"*.mjs\" \"spacing-baseline.json\"",
    "lint:spacing": "node scripts/check-spacing-utilities.mjs",
    "test:spacing": "node --test scripts/*.test.mjs",
    "test:unit": "vitest run"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.29",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.29",
    "@angular/compiler": "^20.3.29",
    "@angular/core": "^20.3.29",
    "@angular/forms": "^20.3.29",
    "@angular/platform-browser": "^20.3.29",
    "@angular/router": "^20.3.29",
    "@primeng/themes": "^20.4.0",
    "leaflet": "^1.9.4",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.1.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.29",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
